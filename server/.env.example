# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/online-turf-booking

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173

# Email (Nodemailer) - use an SMTP provider or a Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Online Turf Booking <no-reply@turfbooking.com>"

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# QR / verification
QR_VERIFY_BASE_URL=http://localhost:5173/verify-booking
